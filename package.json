{
  "name": "paseo-emphasis",
  "version": "0.1.0",
  "private": true,
  "description": "Paseo plugin that renders assistant replies with emphasis markup (status pills, label icons, colored emphasis) and teaches agents the format.",
  "license": "MIT",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.16.0",
    "@types/react": "~19.2.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.4.4"
}
